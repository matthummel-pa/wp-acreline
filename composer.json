{
  "name": "matthummel-pa/wp-acreline",
  "type": "wordpress-theme",
  "license": "GPL-2.0-or-later",
  "description": "Acreline — Sage 11 WordPress theme for rural listings, agents, and showing requests",
  "homepage": "https://github.com/matthummel-pa/wp-acreline",
  "authors": [
    {
      "name": "Matt Hummel",
      "homepage": "https://matthummel.com/"
    },
    {
      "name": "Ben Word",
      "email": "ben@benword.com",
      "homepage": "https://github.com/retlehs"
    },
    {
      "name": "Scott Walkinshaw",
      "email": "scott.walkinshaw@gmail.com",
      "homepage": "https://github.com/swalkinshaw"
    },
    {
      "name": "QWp6t",
      "email": "hi@qwp6t.me",
      "homepage": "https://github.com/qwp6t"
    },
    {
      "name": "Brandon Nifong",
      "email": "brandon@tendency.me",
      "homepage": "https://github.com/log1x"
    }
  ],
  "keywords": [
    "wordpress"
  ],
  "support": {
    "issues": "https://github.com/matthummel-pa/wp-acreline/issues",
    "source": "https://github.com/matthummel-pa/wp-acreline",
    "docs": "https://github.com/matthummel-pa/wp-acreline/blob/main/SUPPORT.md",
    "forum": "https://discourse.roots.io/"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "require": {
    "php": ">=8.3",
    "roots/acorn": "^6.0"
  },
  "require-dev": {
    "laravel/pint": "^1.20"
  },
  "suggest": {
    "log1x/sage-directives": "A collection of useful Blade directives for WordPress and Sage (^1.0)."
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "post-autoload-dump": [
      "Roots\\Acorn\\ComposerScripts::postAutoloadDump"
    ]
  }
}
